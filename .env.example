DJANGO_SECRET_KEY=generate-a-long-random-secret
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_SHARED_SECRET=
TRANSBANK_INTEGRATION_TYPE=TEST

DB_ENGINE=django.db.backends.postgresql
DB_NAME=beatsbd
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FFMPEG_PATH=ffmpeg

# Correo: SMTP para el equipo. Para pruebas locales se puede usar
# django.core.mail.backends.console.EmailBackend (muestra el correo en terminal).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BeatCloud <no-reply@beatcloud.local>
EMAIL_TIMEOUT=15
