# Plantilla local: copiar a .env y completar. Este archivo no se carga directamente.
# Obligatoria: clave aleatoria local de Django; no reutilizar entre ambientes.
DJANGO_SECRET_KEY=
# Transbank TEST: no habilita pagos hasta configurar credenciales de prueba.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_INTEGRATION_TYPE=TEST

# Obligatorios para PostgreSQL local; ajusta usuario, contraseña, host y puerto a tu instalación.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=beatscloud_demo_local
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Desarrollo solamente. En despliegue usar False y dominios HTTPS explícitos.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Requerido para generar previews de audio.
FFMPEG_PATH=ffmpeg

# Opcional: bucket Cloudflare R2 privado para pruebas de integración. Solo se requieren
# credenciales válidas cuando R2_UPLOADS_ENABLED=true. No activar en QA local aislado.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_UPLOADS_ENABLED=false

# Correo: SMTP para el equipo. Para pruebas locales se puede usar
# django.core.mail.backends.console.EmailBackend (muestra el correo en terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BeatCloud <no-reply@beatcloud.local>
EMAIL_TIMEOUT=15

# Optional email providers; leave empty in local/QA. Never commit credentials.
RESEND_API_KEY=
GMAIL_OAUTH_TOKEN_JSON=
