DJANGO_SECRET_KEY=generate-a-long-random-secret
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_SHARED_SECRET=
TRANSBANK_INTEGRATION_TYPE=TEST

# SQLite local por defecto. Para PostgreSQL, usa django.db.backends.postgresql
# y completa DB_NAME, DB_USER, DB_PASSWORD, DB_HOST y DB_PORT.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL de la SPA; FRONTEND_URL se usa para enlaces de activación y retorno de pago.
SPA_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

FFMPEG_PATH=ffmpeg

# En local imprime el enlace de activación en la terminal de Django.
# Para SMTP, cambia EMAIL_BACKEND y completa las variables SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=BeatCloud <no-reply@beatcloud.local>
EMAIL_TIMEOUT=15
