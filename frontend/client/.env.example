VITE_APP_TITLE=BeatsCloud

# hybrid: utiliza la API real de Django y conserva el estado de error si falla.
# mock: utiliza datos locales de demostración, sin validar el backend.
VITE_API_MODE=hybrid

# Vacío: utiliza el proxy de Vite hacia Django en 127.0.0.1:8000.
# Solo configurar si el backend está en otro origen.
VITE_DJANGO_URL=

# No colocar claves privadas ni credenciales en variables VITE_*.
