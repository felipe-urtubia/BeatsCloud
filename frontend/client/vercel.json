{
    "rewrites":  [
                     {
                         "source":  "/api/(.*)",
                         "destination":  "https://beatscloud.onrender.com/api/$1"
                     },
                     {
                         "source":  "/media/(.*)",
                         "destination":  "https://beatscloud.onrender.com/media/$1"
                     },
                     {
                         "source":  "/csrf/",
                         "destination":  "https://beatscloud.onrender.com/csrf/"
                     },
                     {
                         "source":  "/session/",
                         "destination":  "https://beatscloud.onrender.com/session/"
                     },
                     {
                         "source":  "/((?!api/|media/|csrf/|session/).*)",
                         "destination":  "/index.html"
                     }
                 ]
}
