
{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://beatscloud.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://beatscloud.onrender.com/media/:path*"
    },
    {
      "source": "/csrf/",
      "destination": "https://beatscloud.onrender.com/csrf/"
    },
    {
      "source": "/session/",
      "destination": "https://beatscloud.onrender.com/session/"
    },
    {
      "source": "/:path((?!api/|media/|csrf/|session/).*)",
      "destination": "/index.html"
    }
  ]
}
